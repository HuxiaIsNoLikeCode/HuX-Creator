server:
  port: 8080

logging:
  level:
    root: INFO
    com.hux.creator: DEBUG
    org.springframework.web: INFO
    org.hibernate.SQL: DEBUG

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/hux_creator?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&autoReconnect=true
    username: your_mysql_username
    password: your_mysql_password
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      max-lifetime: 300000
      idle-timeout: 60000
      connection-timeout: 30000
      keepalive-time: 60000
      validation-timeout: 5000
      minimum-idle: 2
      maximum-pool-size: 10
      connection-test-query: SELECT 1

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true

  data:
    redis:
      host: localhost
      port: 6379

  ai:
    openai:
      api-key: your_api_key_here
      base-url: https://api.example.com/v1

hux:
  ai:
    providers:
      doubao:
        api-key: your_doubao_api_key
        base-url: https://api.example.com/v1
        model: your_model_name
      qwen:
        api-key: your_qwen_api_key
        base-url: https://api.example.com/v1
        model: your_model_name
      deepseek:
        api-key: your_deepseek_api_key
        base-url: https://api.example.com/v1
        model: your_model_name
      gemini:
        api-key: your_gemini_api_key
        base-url: https://api.example.com/v1
        model: your_model_name

  jwt:
    secret: ${JWT_SECRET:your-jwt-secret-key-at-least-32-characters-long}
    expiration: 86400000

  cors:
    allowed-origins: ${CORS_ORIGINS:http://localhost:3000,http://localhost:5173}
